---
import ThemeToggle from "./ThemeToggle.astro";

const navLinks = [
  {
    label: "Blog",
    href: "/blog",
    external: false,
  },
  {
    label: "About",
    href: "/about",
    external: false,
  },
];
---

<header>
  <nav class="nav-bar">
    <a href="/" class="nav-logo">
      James
    </a>

    <ul class="nav-links">
      {navLinks.map(({ label, href, external }) => (
        <li>
          <a
            href={href}
            {...(external
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            {label}
          </a>
        </li>
      ))}
      <li>
        <ThemeToggle />
      </li>
    </ul>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--rp-base);
    border-bottom: 1px solid var(--rp-highlight-med);
  }

  .nav-bar {
    max-width: var(--body-width);
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .nav-logo {
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--rp-foam);
  }

  .nav-logo:hover {
    color: var(--rp-iris);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-links li {
    display: flex;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding: 0 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--rp-text);
    transition: color 0.15s;
  }

  .nav-links a:hover {
    color: var(--rp-iris);
  }

  /* Stack below the point where logo + links stop fitting on one line */
  @media (max-width: 320px) {
    .nav-bar {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
