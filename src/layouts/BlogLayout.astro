---
import BaseLayout from "./BaseLayout.astro";
import PostMeta from "../components/PostMetadata.astro";

interface Props {
  pageTitle: string;
  description?: string;
  publishDate: string;
  updatedDate?: string;
}

const { pageTitle, description = "", publishDate, updatedDate } = Astro.props;
---

<BaseLayout pageTitle={pageTitle} description={description}>
  <article class="blog-post">
    <header class="post-header">
      <h1>{pageTitle}</h1>
      <PostMeta publishDate={publishDate} updatedDate={updatedDate} />
    </header>

    <div class="blog-post-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 2rem;
  }
</style>
